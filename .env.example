# Demo is synthetic and has no external submission capability.
AUTOPILOT_PROFILE=demo
AUTOPILOT_HOST=127.0.0.1
AUTOPILOT_PORT=4317
# Display-only daily confirmation target (1-50); never grants submission authority.
# AUTOPILOT_DAILY_TARGET=50
# Private local mode requires a non-synced directory and a token of 32+ characters.
# AUTOPILOT_PROFILE=local
# AUTOPILOT_DATA_DIR=C:\Users\YourName\AppData\Local\JobAutopilot
# AUTOPILOT_OWNER_TOKEN=generate-locally-do-not-commit
# Required for private document storage and account workflows. Generate exactly
# 32 random bytes and encode as canonical base64. Never commit or replace the key
# without an offline migration: existing documents remain bound to the old key.
# AUTOPILOT_VAULT_KEY=keep-in-private-secret-store
# Offline Windows backup: a DIFFERENT canonical base64 32-byte key. Recover both
# keys separately; neither is included in the encrypted archive. Do not commit.
# AUTOPILOT_BACKUP_KEY=keep-in-separate-private-secret-store
# Set before booting a restored private database, with all old workers offline.
# Final actions remain blocked until every restored application is reviewed.
# AUTOPILOT_RESTORE_SNAPSHOT_SHA256=checksum-of-the-offline-backup
# Keep false until a private reviewed profile and standing auto-submit policy exist.
# AUTOPILOT_EXTERNAL_SUBMISSION=true
# Server mode requires PostgreSQL and explicit allowed origins.
# AUTOPILOT_DATABASE_URL=postgresql://user:password@localhost:5432/jobautopilot
# AUTOPILOT_ALLOWED_ORIGINS=https://jobs.example.com
# Optional server-only encrypted artifact backend; local remains the default.
# AUTOPILOT_ARTIFACT_BACKEND=s3
# AUTOPILOT_S3_ENDPOINT=https://storage.example.com
# AUTOPILOT_S3_BUCKET=opencareers-artifacts
# AUTOPILOT_S3_REGION=eu-west-1
# Supply AWS SDK credentials via private deployment environment or workload role,
# never inside the repository, image or browser process. Vault key is also required.
# Optional free-only OpenRouter inference. Every model must use an explicit :free
# variant and an explicit provider allowlist; unknown or paid pricing is rejected.
# AUTOPILOT_OPENROUTER_API_KEY=keep-in-private-secret-store
# AUTOPILOT_OPENROUTER_MODEL_ALLOWLIST=vendor/model:free
# AUTOPILOT_OPENROUTER_PROVIDER_ALLOWLIST=provider-slug
# AUTOPILOT_INFERENCE_DAILY_LIMIT=40
# Default strict-zdr-v1; reviewed-career-facts-v1 requires the documented, unexpired Novita review.
# AUTOPILOT_INFERENCE_PRIVACY_REVISION=strict-zdr-v1
