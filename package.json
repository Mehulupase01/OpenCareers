{
  "name": "opencareers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsc -p tsconfig.build.json && vite build --config apps/web/vite.config.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "doctor": "tsx scripts/doctor.ts",
    "public:scan": "tsx scripts/public-scan.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "goldens:p06": "tsx scripts/generate-p06-goldens.ts",
    "api": "tsx apps/api/src/main.ts",
    "worker": "tsx apps/worker/src/main.ts",
    "start": "node dist/apps/api/src/main.js",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/multipart": "10.1.1",
    "@fastify/static": "10.1.3",
    "@fontsource/noto-sans": "^5.3.0",
    "better-sqlite3": "12.11.1",
    "csv-parse": "7.0.2",
    "docx": "^9.7.1",
    "fast-xml-parser": "5.11.1",
    "fastify": "5.12.4",
    "html-to-text": "10.0.1",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.46.0",
    "pdfjs-dist": "6.3.289",
    "pdfkit": "^0.20.2",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yauzl": "3.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/html-to-text": "9.0.4",
    "@types/node": "24.13.5",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "6.1.1",
    "fast-check": "4.10.1",
    "pdf-lib": "1.17.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "yazl": "3.3.1"
  }
}
